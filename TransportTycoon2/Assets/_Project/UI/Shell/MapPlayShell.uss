/* Large type/padding for readable WebGL browser previews. */
.shell-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.shell-hud {
    position: absolute;
    left: 16px;
    top: 16px;
    max-width: 960px;
    padding: 20px 24px;
    background-color: rgba(12, 16, 22, 0.82);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.shell-cash {
    color: rgb(245, 248, 250);
    font-size: 28px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    white-space: normal;
}

.shell-hint {
    color: rgb(210, 218, 226);
    font-size: 20px;
    white-space: normal;
    max-width: 900px;
    margin-bottom: 12px;
}

.shell-panel-toggle {
    margin-top: 4px;
    margin-right: 8px;
    padding: 10px 16px;
    font-size: 20px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
    align-self: flex-start;
}

.shell-panel-toggle:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.vehicles-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    bottom: 96px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.vehicles-panel--hidden {
    display: none;
}

.vehicles-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.vehicles-buy {
    margin-bottom: 12px;
    padding: 10px 14px;
    font-size: 18px;
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

.vehicles-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    margin-bottom: 8px;
}

.vehicles-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.vehicles-row--selected .vehicles-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.orders-section {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
    margin-top: 8px;
    padding-top: 12px;
    border-top-width: 2px;
    border-top-color: rgb(70, 90, 110);
    flex-direction: column;
}

.orders-title {
    color: rgb(245, 248, 250);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.orders-hint {
    color: rgb(180, 190, 200);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.orders-selected {
    color: rgb(80, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

.orders-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    margin-bottom: 8px;
}

.orders-empty {
    color: rgb(180, 190, 200);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.orders-row {
    flex-direction: column;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.orders-row-summary {
    color: rgb(245, 248, 250);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 6px;
}

.orders-row-actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.orders-row-action {
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: rgb(245, 248, 250);
    background-color: rgba(55, 72, 92, 0.98);
    border-width: 1px;
    border-color: rgb(70, 90, 110);
    border-radius: 4px;
}

.orders-apply {
    margin-top: 4px;
    padding: 10px 14px;
    font-size: 18px;
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

.orders-status {
    color: rgb(210, 218, 226);
    font-size: 15px;
    white-space: normal;
    margin-top: 6px;
    min-height: 20px;
}

.vehicles-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.vehicles-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.vehicles-row-summary {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
    margin-bottom: 8px;
}

.vehicles-row-sell {
    padding: 8px 12px;
    font-size: 16px;
    color: rgb(245, 248, 250);
    background-color: rgba(90, 50, 50, 0.95);
    border-width: 1px;
    border-color: rgb(140, 80, 80);
    border-radius: 4px;
    align-self: flex-start;
}

.industries-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    bottom: 96px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.industries-panel--hidden {
    display: none;
}

.industries-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.industries-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.industries-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.industries-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.industries-row-summary {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
}

.industries-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.industries-row--selected .industries-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.towns-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    bottom: 96px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.towns-panel--hidden {
    display: none;
}

.towns-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.towns-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.towns-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.towns-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.towns-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.towns-row-summary {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
    margin-bottom: 4px;
}

.towns-row--selected .towns-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.towns-row-line {
    color: rgb(210, 218, 226);
    font-size: 16px;
    white-space: normal;
    margin-left: 16px;
    margin-top: 2px;
}

.towns-row--selected .towns-row-line {
    color: rgb(180, 255, 255);
}

.build-toolbar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding: 12px 16px;
    background-color: rgba(12, 16, 22, 0.88);
    border-radius: 8px;
    border-top-width: 4px;
    border-top-color: rgb(96, 180, 120);
}

.build-tool {
    margin: 6px;
    padding: 12px 18px;
    font-size: 20px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
    min-height: 48px;
}

.build-tool:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.build-tool--active {
    background-color: rgba(48, 110, 72, 0.95);
    border-color: rgb(96, 180, 120);
    -unity-font-style: bold;
}
