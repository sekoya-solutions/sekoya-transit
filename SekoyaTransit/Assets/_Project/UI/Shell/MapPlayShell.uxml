<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MapPlayShell.uss" />
    <ui:VisualElement name="shell-root" class="shell-root" picking-mode="Ignore">
        <ui:VisualElement name="hud-panel" class="shell-hud" picking-mode="Position">
            <ui:VisualElement class="shell-hud-stats" picking-mode="Ignore">
                <ui:VisualElement class="shell-cash-row" picking-mode="Ignore">
                    <ui:VisualElement name="cash-icon" class="shell-cash-icon" picking-mode="Position" />
                    <ui:Label name="cash-label" class="shell-cash" text="…" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="score-label" class="shell-cash shell-score" text="Score: …" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="shell-hud-panels" picking-mode="Ignore">
                <ui:Button name="vehicles-toggle" class="shell-panel-toggle" text="Vehicles (L)" />
                <ui:Button name="routes-toggle" class="shell-panel-toggle" text="Routes (O)" />
                <ui:Button name="unlocks-toggle" class="shell-panel-toggle" text="Unlocks (U)" />
                <ui:Button name="industries-toggle" class="shell-panel-toggle" text="Industries (I)" />
                <ui:Button name="towns-toggle" class="shell-panel-toggle" text="Towns (T)" />
                <ui:Button name="finance-toggle" class="shell-panel-toggle" text="Finance (F)" />
                <ui:Button name="contracts-toggle" class="shell-panel-toggle" text="Contracts (K)" />
            </ui:VisualElement>
            <ui:VisualElement class="shell-hud-settings" picking-mode="Ignore">
                <ui:Button name="achievements-toggle" class="shell-panel-toggle" text="Achievements (H)" />
                <ui:Button name="save-load-toggle" class="shell-panel-toggle" text="Save / Load" />
                <ui:Button name="sound-toggle" class="shell-panel-toggle" text="Sound" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="vehicles-panel" class="vehicles-panel vehicles-panel--hidden">
            <ui:Label name="vehicles-title" class="vehicles-title" text="Vehicles" picking-mode="Ignore" />
            <ui:Label name="vehicles-station-hint" class="vehicles-station-hint" text="Vehicles of the routes that stop at this station." picking-mode="Ignore" />
            <ui:Button name="vehicles-manage-routes" class="vehicles-manage-routes" text="Manage routes" />
            <ui:ScrollView name="vehicles-list" class="vehicles-list" />
            <ui:Label name="vehicles-empty" class="vehicles-empty" text="No vehicles yet." picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="unlocks-panel" class="unlocks-panel unlocks-panel--hidden">
            <ui:Label name="unlocks-title" class="unlocks-title" text="Vehicle unlocks" picking-mode="Ignore" />
            <ui:ScrollView name="unlocks-list" class="unlocks-list" />
            <ui:Label name="unlocks-empty" class="unlocks-empty" text="No vehicle types." picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="industries-panel" class="industries-panel industries-panel--hidden">
            <ui:Label name="industries-title" class="industries-title" text="Industries" picking-mode="Ignore" />
            <ui:ScrollView name="industries-list" class="industries-list" />
            <ui:Label name="industries-empty" class="industries-empty" text="No industries on this map." picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="towns-panel" class="towns-panel towns-panel--hidden">
            <ui:Label name="towns-title" class="towns-title" text="Towns" picking-mode="Ignore" />
            <ui:Foldout name="towns-rules" class="towns-rules" text="How towns grow" value="true" />
            <ui:ScrollView name="towns-list" class="towns-list" />
            <ui:Label name="towns-empty" class="towns-empty" text="No towns on this map." picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="finance-panel" class="goals-panel finance-panel finance-panel--hidden">
            <ui:Label name="finance-title" class="goals-title" text="Finance" picking-mode="Ignore" />
            <ui:ScrollView name="finance-list" class="goals-list" />
        </ui:VisualElement>
        <ui:VisualElement name="contracts-panel" class="goals-panel contracts-panel contracts-panel--hidden">
            <ui:Label name="contracts-title" class="goals-title contracts-title" text="Contracts" picking-mode="Ignore" />
            <ui:Label name="contracts-available" class="contracts-header" text="Available: 0/6" picking-mode="Ignore" />
            <ui:Label name="contracts-in-progress" class="contracts-header" text="In progress: 0/3" picking-mode="Ignore" />
            <ui:Label name="contracts-empty" class="goals-empty contracts-empty" text="No contracts yet." picking-mode="Ignore" />
            <ui:ScrollView name="contracts-list" class="goals-list" />
            <ui:Label name="contracts-footer" class="contracts-footer" text="New contract will appear next month" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="build-toolbar" class="build-toolbar" picking-mode="Position">
            <ui:VisualElement class="toolbar-left" picking-mode="Ignore">
                <ui:VisualElement class="simulation-speed-controls">
                    <ui:Button name="speed-pause" class="simulation-speed" text="||" />
                    <ui:Button name="speed-x1" class="simulation-speed simulation-speed--selected" text="X1" />
                    <ui:Button name="speed-x2" class="simulation-speed" text="X2" />
                    <ui:Button name="speed-x3" class="simulation-speed" text="X3" />
                </ui:VisualElement>
                <ui:Label name="calendar-date-label" class="shell-cash shell-calendar-date" text="Date: 1900-01-01" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="toolbar-tools" picking-mode="Ignore">
                <ui:Button name="tool-select" class="build-tool" text="Select" />
                <ui:Button name="tool-road" class="build-tool" text="Road" />
                <ui:Button name="tool-rail" class="build-tool" text="Rail" />
                <ui:Button name="tool-station" class="build-tool" text="Road station" />
                <ui:Button name="tool-rail-station" class="build-tool" text="Rail station" />
                <ui:Button name="tool-demolish" class="build-tool" text="Delete" />
            </ui:VisualElement>
            <ui:VisualElement class="toolbar-right" picking-mode="Ignore">
                <ui:Label name="seed-info-label" class="shell-seed-info" text="" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="achievements-panel" class="shell-window achievements-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="shell-window__frame" picking-mode="Position">
                <ui:VisualElement class="shell-window__header" picking-mode="Ignore">
                    <ui:Label name="achievements-title" class="shell-window__title" text="Achievements" picking-mode="Ignore" />
                    <ui:Button name="achievements-close" class="shell-window__close" text="" />
                </ui:VisualElement>
                <ui:ScrollView name="achievements-list" class="shell-window__body" />
                <ui:Label name="achievements-empty" class="goals-empty" text="No achievements defined." picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="routes-panel" class="shell-window routes-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="shell-window__frame" picking-mode="Position">
                <ui:VisualElement class="shell-window__header" picking-mode="Ignore">
                    <ui:Label name="routes-title" class="shell-window__title" text="Routes" picking-mode="Ignore" />
                    <ui:Button name="routes-close" class="shell-window__close" text="" />
                </ui:VisualElement>
                <ui:VisualElement name="routes-header" class="routes-row routes-row--header" picking-mode="Ignore" />
                <ui:ScrollView name="routes-list" class="shell-window__body" />
                <ui:Label name="routes-empty" class="goals-empty" text="No routes yet." picking-mode="Ignore" />
                <ui:Button name="routes-create" class="routes-button routes-create" text="Create a new route" />
            </ui:VisualElement>
            <ui:VisualElement name="routes-dialog" class="routes-dialog" picking-mode="Position">
                <ui:VisualElement class="routes-dialog__card" picking-mode="Position">
                    <ui:Label name="routes-dialog-title" class="routes-dialog__title" text="" picking-mode="Ignore" />
                    <ui:TextField name="routes-dialog-field" class="routes-dialog__field" />
                    <ui:Label name="routes-dialog-message" class="routes-dialog__message" text="" picking-mode="Ignore" />
                    <ui:VisualElement class="routes-dialog__buttons" picking-mode="Ignore">
                        <ui:Button name="routes-dialog-ok" class="routes-button" text="OK" />
                        <ui:Button name="routes-dialog-cancel" class="routes-button" text="Cancel" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="route-stations-panel" class="goals-panel route-side-panel route-side-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="route-side-panel__header" picking-mode="Ignore">
                <ui:Label name="route-stations-title" class="goals-title route-side-panel__title" text="" picking-mode="Ignore" />
                <ui:Button name="route-stations-close" class="shell-window__close" text="" />
            </ui:VisualElement>
            <ui:Label name="route-stations-header" class="contracts-header" text="Stations:" picking-mode="Ignore" />
            <ui:ScrollView name="route-stations-list" class="goals-list" />
            <ui:Label name="route-stations-empty" class="goals-empty" text="" picking-mode="Ignore" />
            <ui:VisualElement name="route-stations-confirm" class="route-confirm" picking-mode="Position">
                <ui:Label name="route-stations-confirm-text" class="route-confirm__text" text="" picking-mode="Ignore" />
                <ui:VisualElement class="routes-dialog__buttons" picking-mode="Ignore">
                    <ui:Button name="route-stations-confirm-yes" class="routes-button" text="Remove" />
                    <ui:Button name="route-stations-confirm-no" class="routes-button" text="Cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="route-stations-hint" class="route-side-panel__hint" text="" picking-mode="Ignore" />
            <ui:Label name="route-stations-warning" class="route-side-panel__warning" text="" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="route-vehicles-panel" class="goals-panel route-side-panel route-side-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="route-side-panel__header" picking-mode="Ignore">
                <ui:Label name="route-vehicles-title" class="goals-title route-side-panel__title" text="" picking-mode="Ignore" />
                <ui:Button name="route-vehicles-close" class="shell-window__close" text="" />
            </ui:VisualElement>
            <ui:Label name="route-vehicles-header" class="contracts-header" text="Vehicles:" picking-mode="Ignore" />
            <ui:ScrollView name="route-vehicles-list" class="goals-list route-vehicles-list" />
            <ui:Label name="route-vehicles-empty" class="goals-empty" text="" picking-mode="Ignore" />
            <ui:Label name="route-vehicles-invalid" class="route-side-panel__warning" text="" picking-mode="Ignore" />
            <ui:Button name="route-vehicles-add-toggle" class="routes-button routes-create" text="Add a vehicle" />
            <ui:VisualElement name="route-vehicles-add-section" class="route-add-section">
                <ui:Label name="route-vehicles-add-header" class="contracts-header" text="" picking-mode="Ignore" />
                <ui:Label name="route-vehicles-none-available" class="goals-empty" text="" picking-mode="Ignore" />
                <ui:ScrollView name="route-vehicles-add-list" class="goals-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="toast-stack" class="toast-stack" picking-mode="Ignore" />
        <ui:VisualElement name="game-over-panel" class="game-over-panel game-over-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="game-over-card" picking-mode="Ignore">
                <ui:Label name="game-over-title" class="game-over-title" text="Game Over" picking-mode="Ignore" />
                <ui:Label name="game-over-message" class="game-over-message" text="Your company has gone bankrupt." picking-mode="Ignore" />
                <ui:Label name="game-over-score" class="game-over-message" text="" picking-mode="Ignore" />
                <ui:Label name="game-over-date" class="game-over-message" text="" picking-mode="Ignore" />
                <ui:Label name="game-over-seed" class="game-over-message" text="" picking-mode="Ignore" />
                <ui:Button name="game-over-new-game" class="new-game-button game-over-new-game" text="New game" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="new-game-panel" class="new-game-panel" picking-mode="Position">
            <ui:VisualElement class="new-game-card" picking-mode="Ignore">
                <ui:Label name="new-game-game-title" class="new-game-game-title" text="Sekoya Transit" picking-mode="Ignore" />
                <ui:Label name="new-game-title" class="new-game-title" text="New game" picking-mode="Ignore" />
                <ui:VisualElement class="new-game-saves-row">
                    <ui:Button name="new-game-continue" class="new-game-button new-game-start" text="Continue" />
                    <ui:Button name="new-game-load" class="new-game-button new-game-start" text="Load game" />
                </ui:VisualElement>
                <ui:Label name="new-game-seed-label" class="new-game-label" text="Seed" picking-mode="Ignore" />
                <ui:VisualElement class="new-game-seed-row">
                    <ui:TextField name="new-game-seed" class="new-game-seed" />
                    <ui:Button name="new-game-random" class="new-game-button" text="Random" />
                </ui:VisualElement>
                <ui:Label name="new-game-seed-error" class="new-game-error new-game-error--hidden" text="Enter a whole number from 0 to 18446744073709551615." picking-mode="Ignore" />
                <ui:Label name="new-game-size-label" class="new-game-label" text="Map size" picking-mode="Ignore" />
                <ui:VisualElement class="new-game-size-row">
                    <ui:Button name="new-game-size-small" class="new-game-button new-game-size" text="Small 128×128" />
                    <ui:Button name="new-game-size-medium" class="new-game-button new-game-size" text="Medium 256×256" />
                    <ui:Button name="new-game-size-large" class="new-game-button new-game-size" text="Large 512×512" />
                </ui:VisualElement>
                <ui:Button name="new-game-start" class="new-game-button new-game-start" text="Start" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="save-load-panel" class="save-load-panel save-load-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="save-load-card" picking-mode="Position">
                <ui:Label name="save-load-title" class="goals-title" text="Save / Load" picking-mode="Ignore" />
                <ui:VisualElement name="save-load-confirm" class="save-load-confirm save-load-confirm--hidden">
                    <ui:Label name="save-load-confirm-text" class="save-load-confirm-text" text="Unsaved progress will be lost. Load anyway?" picking-mode="Ignore" />
                    <ui:VisualElement class="save-load-confirm-buttons">
                        <ui:Button name="save-load-confirm-yes" class="save-load-button" text="Load anyway" />
                        <ui:Button name="save-load-confirm-no" class="save-load-button" text="Cancel" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="save-load-list" class="goals-list" />
                <ui:Label name="save-load-status" class="save-load-status" text="" picking-mode="Ignore" />
                <ui:Button name="save-load-close" class="save-load-button save-load-close" text="Close" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="sound-panel" class="save-load-panel sound-panel sound-panel--hidden" picking-mode="Position">
            <ui:VisualElement class="save-load-card sound-card" picking-mode="Position">
                <ui:Label name="sound-title" class="goals-title" text="Sound" picking-mode="Ignore" />
                <ui:Label name="sound-music-label" class="sound-label" text="Music volume" picking-mode="Ignore" />
                <ui:Slider name="sound-music" class="sound-slider" low-value="0" high-value="1" />
                <ui:Label name="sound-effects-label" class="sound-label" text="Effects volume" picking-mode="Ignore" />
                <ui:Slider name="sound-effects" class="sound-slider" low-value="0" high-value="1" />
                <ui:Toggle name="sound-mute" class="sound-mute" text="Mute all sound" />
                <ui:Button name="sound-close" class="save-load-button save-load-close" text="Close" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
