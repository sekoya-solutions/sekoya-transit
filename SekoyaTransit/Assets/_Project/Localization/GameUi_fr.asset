    m_Localized: Ajouter/Retirer ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374734
    m_Localized: "Il faut au moins 2 gares\_: ajoutez des gares pour faire rouler
      des v\xE9hicules."
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374735
