/* Large type/padding for readable WebGL browser previews. */
.shell-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.shell-hud {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 16px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding: 8px 16px;
    background-color: rgba(12, 16, 22, 0.88);
    border-radius: 8px;
    border-bottom-width: 4px;
    border-bottom-color: rgb(96, 180, 120);
}

.shell-hud-stats {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-right: 24px;
}

.shell-hud-panels {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-grow: 1;
    justify-content: flex-end;
}

.shell-cash {
    color: rgb(245, 248, 250);
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 24px;
    white-space: normal;
}

.shell-score {
    margin-left: 0;
}

.shell-calendar-date {
    margin-left: 6px;
    margin-right: 0;
}

.simulation-speed-controls {
    flex-direction: row;
}

.simulation-speed {
    min-width: 64px;
    min-height: 48px;
    margin: 6px;
    padding: 12px 18px;
    font-size: 20px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.simulation-speed:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.simulation-speed--selected {
    background-color: rgba(48, 110, 72, 0.95);
    border-color: rgb(96, 180, 120);
    -unity-font-style: bold;
}

.shell-hint {
    position: absolute;
    left: 16px;
    right: 556px;
    bottom: 150px;
    padding: 8px 14px;
    color: rgb(210, 218, 226);
    font-size: 18px;
    white-space: normal;
    background-color: rgba(12, 16, 22, 0.82);
    border-radius: 8px;
}

.shell-panel-toggle {
    margin: 2px 0 2px 6px;
    padding: 6px 12px;
    font-size: 16px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.shell-panel-toggle:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.game-over-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.78);
}

.game-over-panel--hidden {
    display: none;
}

.game-over-card {
    min-width: 420px;
    max-width: 720px;
    padding: 32px 40px;
    align-items: center;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.game-over-title {
    color: rgb(245, 248, 250);
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.game-over-message {
    color: rgb(210, 218, 226);
    font-size: 22px;
    white-space: normal;
}

.game-over-new-game {
    margin-top: 24px;
}

/* New game screen (Issue #67): full-screen card shown before any world exists. */
.shell-root--new-game .shell-hud,
.shell-root--new-game .build-toolbar,
.shell-root--new-game .toast-stack {
    display: none;
}

.new-game-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(18, 22, 28);
}

.new-game-panel--hidden {
    display: none;
}

.new-game-card {
    width: 720px;
    max-width: 95%;
    padding: 32px 40px;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.new-game-title {
    color: rgb(245, 248, 250);
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 24px;
}

.new-game-label {
    color: rgb(210, 218, 226);
    font-size: 22px;
    margin-bottom: 8px;
}

.new-game-seed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.new-game-seed {
    flex-grow: 1;
    margin: 0;
    margin-right: 12px;
    font-size: 22px;
}

.new-game-seed > .unity-base-text-field__input {
    padding: 10px 12px;
    font-size: 22px;
}

.new-game-error {
    color: rgb(240, 130, 120);
    font-size: 18px;
    white-space: normal;
    margin-bottom: 8px;
}

.new-game-error--hidden {
    display: none;
}

.new-game-size-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.new-game-button {
    margin: 0 8px 8px 0;
    padding: 10px 16px;
    font-size: 20px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.new-game-button:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.new-game-size--selected {
    background-color: rgba(52, 110, 74, 0.98);
    border-color: rgb(96, 180, 120);
}

.new-game-start {
    align-self: flex-start;
    margin-top: 8px;
    padding: 12px 36px;
    font-size: 24px;
}

.new-game-start:disabled {
    opacity: 0.45;
}

.vehicles-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.vehicles-panel--hidden {
    display: none;
}

.vehicles-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.vehicles-buy-hint {
    color: rgb(210, 218, 226);
    font-size: 16px;
    margin-bottom: 8px;
    white-space: normal;
}

.vehicles-buy-list {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 140px;
    margin-bottom: 12px;
}

.vehicles-buy-option {
    margin-bottom: 6px;
    padding: 8px 12px;
    font-size: 16px;
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

.unlocks-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.unlocks-panel--hidden {
    display: none;
}

.unlocks-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.unlocks-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    margin-bottom: 8px;
}

.unlocks-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.unlocks-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgba(28, 36, 46, 0.95);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(70, 90, 110);
}

.unlocks-row-summary {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgb(245, 248, 250);
    font-size: 16px;
    white-space: normal;
    margin-right: 8px;
}

.unlocks-row-action {
    flex-grow: 0;
    flex-shrink: 0;
    padding: 8px 12px;
    font-size: 16px;
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

.vehicles-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    margin-bottom: 8px;
}

.vehicles-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.vehicles-row--selected .vehicles-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.vehicles-row--locked {
    opacity: 0.5;
}

.orders-section {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
    margin-top: 8px;
    padding-top: 12px;
    border-top-width: 2px;
    border-top-color: rgb(70, 90, 110);
    flex-direction: column;
}

.orders-title {
    color: rgb(245, 248, 250);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.orders-hint {
    color: rgb(180, 190, 200);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.orders-selected {
    color: rgb(80, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 8px;
}

.orders-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    margin-bottom: 8px;
}

.orders-empty {
    color: rgb(180, 190, 200);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 8px;
}

.orders-row {
    flex-direction: column;
    margin-bottom: 8px;
    padding: 10px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.orders-row-summary {
    color: rgb(245, 248, 250);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 6px;
}

.orders-row-actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.orders-row-action {
    margin-right: 6px;
    margin-bottom: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: rgb(245, 248, 250);
    background-color: rgba(55, 72, 92, 0.98);
    border-width: 1px;
    border-color: rgb(70, 90, 110);
    border-radius: 4px;
}

.orders-apply {
    margin-top: 4px;
    padding: 10px 14px;
    font-size: 18px;
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

.orders-status {
    color: rgb(210, 218, 226);
    font-size: 15px;
    white-space: normal;
    margin-top: 6px;
    min-height: 20px;
}

.vehicles-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.vehicles-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.vehicles-row-summary {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
    margin-bottom: 8px;
}

.vehicles-row-sell {
    padding: 8px 12px;
    font-size: 16px;
    color: rgb(245, 248, 250);
    background-color: rgba(90, 50, 50, 0.95);
    border-width: 1px;
    border-color: rgb(140, 80, 80);
    border-radius: 4px;
    align-self: flex-start;
}

.industries-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.industries-panel--hidden {
    display: none;
}

.industries-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.industries-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.industries-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.industries-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.industries-row-summary {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
}

.industries-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.industries-row--selected .industries-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.towns-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.towns-panel--hidden {
    display: none;
}

.towns-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.towns-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.towns-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.towns-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.towns-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.towns-row-summary {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
    margin-bottom: 4px;
}

.towns-row--selected .towns-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.towns-row-line {
    color: rgb(210, 218, 226);
    font-size: 16px;
    white-space: normal;
    margin-left: 16px;
    margin-top: 2px;
}

.towns-row--selected .towns-row-line {
    color: rgb(180, 255, 255);
}

.build-toolbar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(12, 16, 22, 0.88);
    border-radius: 8px;
    border-top-width: 4px;
    border-top-color: rgb(96, 180, 120);
}

.toolbar-left {
    flex-direction: column;
    align-items: flex-start;
}

.toolbar-tools {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    justify-content: center;
}

.toolbar-right {
    min-width: 200px;
    align-items: flex-end;
}

.shell-seed-info {
    color: rgb(245, 248, 250);
    font-size: 20px;
    white-space: normal;
}

.build-tool {
    margin: 6px;
    padding: 12px 18px;
    font-size: 20px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
    min-height: 48px;
}

.build-tool:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.build-tool--active {
    background-color: rgba(48, 110, 72, 0.95);
    border-color: rgb(96, 180, 120);
    -unity-font-style: bold;
}

.goals-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 520px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.finance-panel--hidden,
.achievements-panel--hidden,
.contracts-panel--hidden {
    display: none;
}

.goals-title {
    color: rgb(245, 248, 250);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.goals-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.goals-empty {
    color: rgb(180, 190, 200);
    font-size: 18px;
    white-space: normal;
}

.finance-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
}

.finance-row-label {
    color: rgb(210, 218, 226);
    font-size: 18px;
    white-space: normal;
}

.finance-row-value {
    color: rgb(245, 248, 250);
    font-size: 18px;
}

.finance-row--heading {
    margin-top: 14px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 90, 110);
}

.finance-row--heading .finance-row-label {
    color: rgb(245, 248, 250);
    font-size: 22px;
    -unity-font-style: bold;
}

.finance-row--total .finance-row-label,
.finance-row--total .finance-row-value,
.finance-row--net .finance-row-label,
.finance-row--net .finance-row-value {
    -unity-font-style: bold;
}

.finance-row--net .finance-row-value {
    color: rgb(180, 255, 200);
}

.achievements-row,
.contracts-row {
    margin-bottom: 8px;
    padding: 10px 12px;
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.achievements-row--completed {
    border-color: rgb(96, 180, 120);
    border-left-width: 6px;
    color: rgb(190, 245, 205);
}

.contracts-row:hover {
    border-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.toast-stack {
    position: absolute;
    left: 16px;
    bottom: 112px;
    width: 560px;
    flex-direction: column;
}

.toast {
    margin-bottom: 6px;
    padding: 8px 14px;
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

/* Save and load panel (Issue #183): a centered card above the game and the new game screen. */
.new-game-saves-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.save-load-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.save-load-panel--hidden {
    display: none;
}

.save-load-card {
    width: 640px;
    max-width: 95%;
    max-height: 90%;
    padding: 20px 24px;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.save-load-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
}

.save-load-row-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.save-load-row-name {
    color: rgb(245, 248, 250);
    font-size: 20px;
    -unity-font-style: bold;
}

.save-load-row-info {
    color: rgb(170, 182, 194);
    font-size: 16px;
    white-space: normal;
}

.save-load-button {
    margin: 0 0 0 8px;
    padding: 6px 14px;
    font-size: 18px;
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.save-load-button:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.save-load-button:disabled {
    opacity: 0.45;
}

.save-load-confirm {
    padding: 10px 12px;
    margin-bottom: 10px;
    background-color: rgba(120, 70, 30, 0.45);
    border-radius: 6px;
}

.save-load-confirm--hidden {
    display: none;
}

.save-load-confirm-text {
    color: rgb(245, 248, 250);
    font-size: 18px;
    white-space: normal;
}

.save-load-confirm-buttons {
    flex-direction: row;
    margin-top: 8px;
}

.save-load-status {
    color: rgb(210, 218, 226);
    font-size: 16px;
    margin-top: 10px;
    min-height: 20px;
    white-space: normal;
}

.save-load-close {
    align-self: flex-end;
    margin-top: 8px;
}

.save-load-card .goals-list {
    flex-grow: 0;
    height: 340px;
}
