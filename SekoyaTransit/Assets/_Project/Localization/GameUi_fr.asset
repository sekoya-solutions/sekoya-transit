      m_Items: []
  - m_Id: 2968023449374754
    m_Localized: Aucune gare pour l'instant.
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374755
    m_Localized: "Impossible de m\xE9langer gares routi\xE8res et gares ferroviaires\_!"
