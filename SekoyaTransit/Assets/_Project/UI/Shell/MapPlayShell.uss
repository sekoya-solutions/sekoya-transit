/* Large type/padding for readable WebGL browser previews. */

/* Type scale (Issue #237): every font-size uses one of these variables.
   L: cash, score, date and window titles. M: window text, buttons and lists. S: tips, hints, errors and empty-list
   messages. Display: game title and game over screens. */
:root {
    --font-l: 28px;
    --font-m: 22px;
    --font-s: 18px;
    --font-display: 42px;
}

.shell-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.shell-hud {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 16px;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding: 8px 16px;
    background-color: rgba(12, 16, 22, 0.88);
    border-radius: 8px;
    border-bottom-width: 4px;
    border-bottom-color: rgb(96, 180, 120);
}

.shell-hud-stats {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 24px;
}

.shell-hud-panels {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    justify-content: center;
}

.shell-hud-settings {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-grow: 1;
    flex-basis: 0;
    justify-content: flex-end;
    margin-left: 24px;
}

.shell-cash {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-right: 24px;
    white-space: normal;
}

.shell-score {
    margin-left: 0;
}

.shell-calendar-date {
    margin-left: 6px;
    margin-right: 0;
}

.simulation-speed-controls {
    flex-direction: row;
}

.simulation-speed {
    min-width: 64px;
    min-height: 48px;
    margin: 6px;
    padding: 12px 18px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.simulation-speed:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.simulation-speed--selected {
    background-color: rgba(48, 110, 72, 0.95);
    border-color: rgb(96, 180, 120);
    -unity-font-style: bold;
}

.shell-panel-toggle {
    margin: 2px 0 2px 6px;
    padding: 6px 12px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.shell-panel-toggle:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.game-over-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.78);
}

.game-over-panel--hidden {
    display: none;
}

.game-over-card {
    min-width: 420px;
    max-width: 720px;
    padding: 32px 40px;
    align-items: center;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.game-over-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-display);
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.game-over-message {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
    white-space: normal;
}

.game-over-new-game {
    margin-top: 24px;
}

/* New game screen (Issue #67): full-screen card shown before any world exists. */
.shell-root--new-game .shell-hud,
.shell-root--new-game .build-toolbar,
.shell-root--new-game .toast-stack {
    display: none;
}

.new-game-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(18, 22, 28);
}

.new-game-panel--hidden {
    display: none;
}

.new-game-card {
    width: 720px;
    max-width: 95%;
    padding: 32px 40px;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.new-game-game-title {
    color: rgb(96, 180, 120);
    font-size: var(--font-display);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.new-game-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-bottom: 24px;
}

.new-game-label {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
    margin-bottom: 8px;
}

.new-game-seed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.new-game-seed {
    flex-grow: 1;
    margin: 0;
    margin-right: 12px;
    font-size: var(--font-m);
}

.new-game-seed > .unity-base-text-field__input {
    padding: 10px 12px;
    font-size: var(--font-m);
}

.new-game-error {
    color: rgb(240, 130, 120);
    font-size: var(--font-s);
    white-space: normal;
    margin-bottom: 8px;
}

.new-game-error--hidden {
    display: none;
}

.new-game-size-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.new-game-button {
    margin: 0 8px 8px 0;
    padding: 10px 16px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.new-game-button:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.new-game-size--selected {
    background-color: rgba(52, 110, 74, 0.98);
    border-color: rgb(96, 180, 120);
}

.new-game-start {
    align-self: flex-start;
    margin-top: 8px;
    padding: 12px 36px;
    font-size: var(--font-m);
}

.new-game-start:disabled {
    opacity: 0.45;
}

.vehicles-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.vehicles-panel--hidden {
    display: none;
}

.vehicles-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.unlocks-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.unlocks-panel--hidden {
    display: none;
}

.unlocks-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.unlocks-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    margin-bottom: 8px;
}

.unlocks-empty {
    color: rgb(180, 190, 200);
    font-size: var(--font-s);
    white-space: normal;
}

.unlocks-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgba(28, 36, 46, 0.95);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(70, 90, 110);
}

.unlocks-row-summary {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
    margin-right: 8px;
}

.unlocks-row-action {
    flex-grow: 0;
    flex-shrink: 0;
    padding: 8px 12px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

.vehicles-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    margin-bottom: 8px;
}

.vehicles-empty {
    color: rgb(180, 190, 200);
    font-size: var(--font-s);
    white-space: normal;
}

.vehicles-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.vehicles-row-summary {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
    margin-bottom: 8px;
}

.vehicles-row-sell {
    padding: 8px 12px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(90, 50, 50, 0.95);
    border-width: 1px;
    border-color: rgb(140, 80, 80);
    border-radius: 4px;
    align-self: flex-start;
}

.industries-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.industries-panel--hidden {
    display: none;
}

.industries-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.industries-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.industries-empty {
    color: rgb(180, 190, 200);
    font-size: var(--font-s);
    white-space: normal;
}

.industries-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.industries-row-summary {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
}

.industries-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.industries-row--selected .industries-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.towns-panel {
    position: absolute;
    right: 16px;
    /* Fallback insets; PanelBetweenToolbars sets equal gaps to both toolbars once their layout is known. */
    top: 96px;
    bottom: 150px;
    width: 35%;
    min-width: 460px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.towns-panel--hidden {
    display: none;
}

.towns-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.towns-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.towns-empty {
    color: rgb(180, 190, 200);
    font-size: var(--font-s);
    white-space: normal;
}

.towns-row {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 12px;
    background-color: rgba(40, 52, 66, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.towns-row--selected {
    border-color: rgb(80, 255, 255);
    border-width: 3px;
    border-left-width: 8px;
    border-left-color: rgb(80, 255, 255);
    background-color: rgba(20, 90, 110, 0.95);
}

.towns-row-summary {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
    margin-bottom: 4px;
}

.towns-row--selected .towns-row-summary {
    color: rgb(180, 255, 255);
    -unity-font-style: bold;
}

.towns-row-line {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
    white-space: normal;
    margin-left: 16px;
    margin-top: 2px;
}

.towns-row--selected .towns-row-line {
    color: rgb(180, 255, 255);
}

.towns-rules {
    margin-bottom: 10px;
    flex-shrink: 0;
}

.towns-rules .unity-foldout__text {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
}

.towns-rules .unity-foldout__checkmark {
    -unity-background-image-tint-color: rgb(245, 248, 250);
}

.towns-rules .unity-foldout__content {
    margin-left: 0;
}

.towns-rules-line {
    color: rgb(210, 218, 226);
    font-size: var(--font-s);
    white-space: normal;
    margin-top: 4px;
}

.towns-row-header {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
    margin-top: 8px;
}

.towns-row--selected .towns-row-header {
    color: rgb(180, 255, 255);
}

.towns-row-need {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
    white-space: normal;
    margin-left: 16px;
    margin-top: 2px;
}

.towns-row--selected .towns-row-need {
    color: rgb(180, 255, 255);
}

.towns-row-need.towns-need--partly-met {
    color: rgb(130, 190, 255);
}

.towns-row-need.towns-need--fully-met {
    color: rgb(140, 230, 160);
}

.build-toolbar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: rgba(12, 16, 22, 0.88);
    border-radius: 8px;
    border-top-width: 4px;
    border-top-color: rgb(96, 180, 120);
}

.toolbar-left {
    flex-direction: column;
    align-items: flex-start;
}

.toolbar-tools {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    justify-content: center;
}

.toolbar-right {
    min-width: 200px;
    align-items: flex-end;
}

.shell-seed-info {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
}

.build-tool {
    margin: 6px;
    padding: 12px 18px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
    min-height: 48px;
}

.build-tool:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.build-tool--active {
    background-color: rgba(48, 110, 72, 0.95);
    border-color: rgb(96, 180, 120);
    -unity-font-style: bold;
}

.goals-panel {
    position: absolute;
    right: 16px;
    top: 96px;
    bottom: 150px;
    width: 520px;
    padding: 16px 18px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
    flex-direction: column;
}

.finance-panel--hidden,
.achievements-panel--hidden,
.contracts-panel--hidden {
    display: none;
}

.goals-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.goals-list {
    flex-grow: 1;
    margin-bottom: 8px;
}

.goals-empty {
    color: rgb(180, 190, 200);
    font-size: var(--font-s);
    white-space: normal;
}

.finance-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
}

.finance-row-label {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
    white-space: normal;
}

.finance-row-value {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
}

.finance-row--heading {
    margin-top: 14px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 90, 110);
}

.finance-row--heading .finance-row-label {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
}

.finance-row--total .finance-row-label,
.finance-row--total .finance-row-value,
.finance-row--net .finance-row-label,
.finance-row--net .finance-row-value {
    -unity-font-style: bold;
}

.finance-row--net .finance-row-value {
    color: rgb(180, 255, 200);
}

/* Contracts panel (Issue #227): about 20% of the screen, as narrow as a card stays readable, so most of the map remains
   visible and a town can still be clicked. One card per contract, colored by status. */
.contracts-panel {
    width: 20%;
    min-width: 340px;
    max-width: 420px;
}

.contracts-title {
    margin-bottom: 4px;
}

.contracts-header {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
    margin-bottom: 2px;
}

.contracts-empty {
    margin-top: 10px;
}

.contracts-card {
    margin-bottom: 10px;
    padding: 8px 10px;
    font-size: var(--font-m);
    white-space: normal;
    background-color: rgba(26, 34, 44, 0.95);
    border-radius: 12px;
    border-width: 3px;
}

.contracts-card--proposal {
    color: rgb(240, 244, 248);
    border-color: rgb(200, 208, 216);
}

.contracts-card--accepted {
    color: rgb(130, 190, 255);
    border-color: rgb(60, 130, 220);
}

.contracts-card--completed {
    color: rgb(140, 230, 160);
    border-color: rgb(56, 170, 84);
}

.contracts-card--failed {
    color: rgb(255, 140, 140);
    border-color: rgb(210, 60, 60);
}

.contracts-card--locked {
    opacity: 0.5;
}

.contracts-description {
    padding: 2px 0;
}

.contracts-description:hover {
    background-color: rgba(80, 255, 255, 0.18);
    border-radius: 4px;
}

.contracts-detail {
    margin-top: 4px;
    font-size: var(--font-m);
    white-space: normal;
}

.contracts-buttons {
    flex-direction: row;
    justify-content: space-around;
    margin-top: 8px;
}

.contracts-button {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 90px;
    padding: 5px 10px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(200, 208, 216);
    border-radius: 8px;
}

.contracts-button:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.contracts-button:disabled {
    opacity: 0.5;
}

.contracts-card--accepted .contracts-button {
    color: rgb(130, 190, 255);
    border-color: rgb(60, 130, 220);
}

.contracts-card--completed .contracts-button {
    color: rgb(140, 230, 160);
    border-color: rgb(56, 170, 84);
}

.contracts-card--failed .contracts-button {
    color: rgb(255, 140, 140);
    border-color: rgb(210, 60, 60);
}

.contracts-footer {
    margin-top: 4px;
    color: rgb(180, 190, 200);
    font-size: var(--font-s);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Near full-screen window (Issue #223): a dimmed backdrop over the whole screen and a framed window with a title and a
   close cross. Reused by the panel reworks; the hidden modifier class stays per window. */
.shell-window {
    position: absolute;
    left: 0;
    right: 0;
    /* Same insets as the side panels so the top HUD and bottom toolbar stay visible and clickable. */
    top: 96px;
    bottom: 150px;
    padding: 16px 56px;
    background-color: rgba(4, 6, 10, 0.72);
    align-items: stretch;
    justify-content: center;
}

.shell-window__frame {
    flex-grow: 1;
    flex-direction: column;
    padding: 20px 28px 16px 28px;
    background-color: rgba(12, 16, 22, 0.97);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
    border-top-width: 4px;
    border-top-color: rgb(96, 180, 120);
}

.shell-window__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.shell-window__title {
    color: rgb(245, 248, 250);
    font-size: var(--font-l);
    -unity-font-style: bold;
}

.shell-window__close {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    background-color: rgba(40, 52, 66, 0.95);
    background-image: url("/Assets/_Project/Art/Icons/Common/close.svg");
    -unity-background-scale-mode: scale-to-fit;
    background-size: 60% 60%;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.shell-window__close:hover {
    background-color: rgba(150, 50, 50, 0.95);
    border-color: rgb(230, 110, 110);
}

.shell-window__body {
    flex-grow: 1;
}

.achievements-section-title {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 6px;
}

.achievements-section {
    padding: 4px 16px;
    margin-bottom: 8px;
    background-color: rgba(28, 36, 46, 0.95);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
}

.achievements-track {
    flex-direction: row;
    align-items: center;
    min-height: 140px;
}

.achievements-track__labels {
    width: 240px;
    flex-shrink: 0;
    flex-direction: column;
    padding-right: 12px;
}

.achievements-track__label {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
}

.achievements-track__value {
    color: rgb(170, 220, 255);
    font-size: var(--font-m);
    margin-top: 2px;
}

.achievements-track__bar-area {
    flex-grow: 1;
    height: 140px;
}

.achievements-track__bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 48px;
    height: 8px;
    background-color: rgb(52, 62, 74);
    border-radius: 4px;
    overflow: hidden;
}

.achievements-track__fill {
    height: 100%;
    background-color: rgb(64, 170, 255);
    border-radius: 4px;
}

.achievements-milestone {
    position: absolute;
    top: 0;
    width: 220px;
    margin-left: -110px;
    align-items: center;
}

.achievements-milestone__title {
    color: rgb(140, 150, 160);
    font-size: var(--font-m);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    height: 26px;
    margin-top: 6px;
}

.achievements-milestone__trophy {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(120, 125, 130);
    opacity: 0.55;
}

.achievements-milestone--bronze .achievements-milestone__trophy {
    background-image: url("/Assets/_Project/Art/Icons/Trophies/trophy_bronze.svg");
}

.achievements-milestone--silver .achievements-milestone__trophy {
    background-image: url("/Assets/_Project/Art/Icons/Trophies/trophy_silver.svg");
}

.achievements-milestone--gold .achievements-milestone__trophy {
    background-image: url("/Assets/_Project/Art/Icons/Trophies/trophy_gold.svg");
}

.achievements-milestone--unlocked .achievements-milestone__trophy {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
}

.achievements-milestone--unlocked .achievements-milestone__title {
    color: rgb(80, 175, 255);
}

.achievements-milestone__goal {
    color: rgb(150, 160, 170);
    font-size: var(--font-m);
    -unity-text-align: middle-center;
}

.achievements-milestone--unlocked .achievements-milestone__goal {
    color: rgb(235, 240, 245);
}

.achievements-milestone__date {
    color: rgb(130, 140, 150);
    font-size: var(--font-s);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

.toast-stack {
    position: absolute;
    left: 16px;
    bottom: 156px;
    width: 640px;
    flex-direction: column;
}

.toast {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 10px 16px;
    background-color: rgba(12, 16, 22, 0.92);
    border-radius: 6px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.toast__text {
    flex-shrink: 1;
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
}

/* Trophy of an unlocked achievement milestone before the toast text (Issue #223). */
.toast__icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.toast__icon--trophy-bronze {
    background-image: url("/Assets/_Project/Art/Icons/Trophies/trophy_bronze.svg");
}

.toast__icon--trophy-silver {
    background-image: url("/Assets/_Project/Art/Icons/Trophies/trophy_silver.svg");
}

.toast__icon--trophy-gold {
    background-image: url("/Assets/_Project/Art/Icons/Trophies/trophy_gold.svg");
}

/* Save and load panel (Issue #183): a centered card above the game and the new game screen. */
.new-game-saves-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.save-load-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.save-load-panel--hidden {
    display: none;
}

.save-load-card {
    width: 640px;
    max-width: 95%;
    max-height: 90%;
    padding: 20px 24px;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: rgb(96, 180, 120);
}

.save-load-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
}

.save-load-row-texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.save-load-row-name {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
}

.save-load-row-info {
    color: rgb(170, 182, 194);
    font-size: var(--font-m);
    white-space: normal;
}

.save-load-button {
    margin: 0 0 0 8px;
    padding: 6px 14px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(70, 90, 110);
    border-radius: 6px;
}

.save-load-button:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.save-load-button:disabled {
    opacity: 0.45;
}

.save-load-confirm {
    padding: 10px 12px;
    margin-bottom: 10px;
    background-color: rgba(120, 70, 30, 0.45);
    border-radius: 6px;
}

.save-load-confirm--hidden {
    display: none;
}

.save-load-confirm-text {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
}

.save-load-confirm-buttons {
    flex-direction: row;
    margin-top: 8px;
}

.save-load-status {
    color: rgb(210, 218, 226);
    font-size: var(--font-s);
    margin-top: 10px;
    min-height: 20px;
    white-space: normal;
}

.save-load-close {
    align-self: flex-end;
    margin-top: 8px;
}

.save-load-card .goals-list {
    flex-grow: 0;
    height: 340px;
}

/* Issue #182: icon-only buttons (the localized name moves to the tooltip), cash icon, cargo icons in rows,
   and the runtime tooltip. Icons are the SVG files under Art/Icons, imported as UI Toolkit vector images. */
.build-tool,
.simulation-speed,
.shell-panel-toggle {
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}

.build-tool {
    min-width: 56px;
    min-height: 56px;
    padding: 0;
    background-size: 36px 36px;
}

.simulation-speed {
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    background-size: 30px 30px;
}

.shell-panel-toggle {
    width: 44px;
    height: 44px;
    padding: 0;
    background-size: 30px 30px;
}

.shell-cash-row {
    flex-direction: row;
    align-items: center;
}

.shell-cash-icon {
    width: 26px;
    height: 26px;
    margin-right: 6px;
    background-image: url("/Assets/_Project/Art/Icons/Common/dollar.svg");
}

#tool-select {
    background-image: url("/Assets/_Project/Art/Icons/Tools/select.svg");
}

#tool-road {
    background-image: url("/Assets/_Project/Art/Icons/Tools/road.svg");
}

#tool-rail {
    background-image: url("/Assets/_Project/Art/Icons/Tools/rail.svg");
}

#tool-station {
    background-image: url("/Assets/_Project/Art/Icons/Tools/road_station.svg");
}

#tool-rail-station {
    background-image: url("/Assets/_Project/Art/Icons/Tools/rail_station.svg");
}

#tool-demolish {
    background-image: url("/Assets/_Project/Art/Icons/Tools/delete.svg");
}

#speed-pause {
    background-image: url("/Assets/_Project/Art/Icons/Speed/pause.svg");
}

#speed-x1 {
    background-image: url("/Assets/_Project/Art/Icons/Speed/x1.svg");
}

#speed-x2 {
    background-image: url("/Assets/_Project/Art/Icons/Speed/x2.svg");
}

#speed-x3 {
    background-image: url("/Assets/_Project/Art/Icons/Speed/x3.svg");
}

#vehicles-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/vehicles.svg");
}

#routes-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/routes.svg");
}

#unlocks-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/unlocks.svg");
}

#industries-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/industries.svg");
}

#towns-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/towns.svg");
}

#finance-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/finance.svg");
}

#achievements-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/achievements.svg");
}

#contracts-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/contracts.svg");
}

#save-load-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/save_load.svg");
}

.text-line {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.text-line__text {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    white-space: nowrap;
}

.text-line__chunk {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.text-line__icon {
    width: 20px;
    height: 20px;
    margin: 0 4px 0 0;
    flex-shrink: 0;
}

.text-line__icon--cash {
    margin: 0 0 0 3px;
    background-image: url("/Assets/_Project/Art/Icons/Common/dollar.svg");
}

.text-line__icon--population {
    margin: 0 0 0 3px;
    background-image: url("/Assets/_Project/Art/Icons/Common/population.svg");
}

.contracts-button .text-line {
    justify-content: center;
}

.shell-tooltip {
    position: absolute;
    max-width: 320px;
    padding: 6px 10px;
    color: rgb(245, 248, 250);
    font-size: var(--font-s);
    white-space: normal;
    background-color: rgba(12, 16, 22, 0.96);
    border-width: 1px;
    border-color: rgb(96, 180, 120);
    border-radius: 4px;
}

.shell-tooltip--hidden {
    display: none;
}

.text-line__piece--space-after {
    margin-right: 5px;
}

#sound-toggle {
    background-image: url("/Assets/_Project/Art/Icons/Panels/sound.svg");
}

.sound-panel--hidden {
    display: none;
}

.sound-card {
    width: 480px;
}

.sound-label {
    margin-top: 6px;
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
}

.sound-slider {
    margin: 4px 0 8px 0;
}

.sound-mute {
    margin-top: 8px;
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
}

.sound-mute Label {
    color: rgb(245, 248, 250);
}

/* Themed scrollbars for every shell scroll view (Issue #223 preview feedback): a slim rounded thumb on a dark track,
   without the default arrow buttons, so the lists match the rest of the interface. Scoped to .unity-scroller so the
   sound volume sliders keep their own look. */
.shell-root .unity-scroller {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.shell-root .unity-scroller--vertical {
    width: 12px;
    min-width: 12px;
    margin-left: 6px;
}

.shell-root .unity-scroller--horizontal {
    height: 12px;
    min-height: 12px;
    margin-top: 6px;
}

.shell-root .unity-scroller .unity-scroller__low-button,
.shell-root .unity-scroller .unity-scroller__high-button {
    display: none;
}

.shell-root .unity-scroller .unity-scroller__slider {
    margin: 0;
    flex-grow: 1;
}

.shell-root .unity-scroller .unity-base-slider__tracker {
    margin: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgba(40, 52, 66, 0.7);
}

.shell-root .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    right: 0;
    width: auto;
}

.shell-root .unity-scroller--horizontal .unity-base-slider__tracker {
    top: 0;
    bottom: 0;
    height: auto;
}

.shell-root .unity-scroller .unity-base-slider__dragger {
    margin: 0;
    border-width: 0;
    border-radius: 6px;
    background-color: rgb(92, 112, 132);
}

.shell-root .unity-scroller--vertical .unity-base-slider__dragger {
    left: 1px;
    width: 10px;
    min-height: 32px;
}

.shell-root .unity-scroller--horizontal .unity-base-slider__dragger {
    top: 1px;
    height: 10px;
    min-width: 32px;
}

.shell-root .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgb(96, 180, 120);
}

.shell-root .unity-scroller .unity-base-slider__dragger-border {
    display: none;
}

/* Heading above the unassigned vehicles in the Vehicles panel (Issue #229). */
.vehicles-section-header {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
}

/* Vehicles panel with a station selected (Issue #229): a hint and the button that opens the routes window. */
.vehicles-station-hint {
    color: rgb(210, 218, 226);
    font-size: var(--font-s);
    margin-bottom: 6px;
    white-space: normal;
}

.vehicles-manage-routes {
    align-self: flex-start;
    margin-bottom: 12px;
    padding: 8px 12px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(48, 110, 72, 0.95);
    border-width: 2px;
    border-color: rgb(96, 180, 120);
    border-radius: 6px;
}

/* Routes window (Issue #229): the near full-screen window of Issue #223 with one row per route, columns sized by
   flex grow so the header and the rows line up, and a modal dialog for names and deletes. */
.routes-panel--hidden,
.route-side-panel--hidden,
.routes-dialog--hidden {
    display: none;
}

.routes-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 6px;
    background-color: rgba(26, 34, 44, 0.95);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(26, 34, 44, 0.95);
}

.routes-row--header {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    margin-bottom: 2px;
    padding-right: 24px;
}

.routes-row--highlighted {
    border-color: rgb(80, 220, 255);
}

.routes-row--invalid {
    border-color: rgb(210, 60, 60);
}

.routes-cell {
    flex-shrink: 1;
    flex-basis: 0;
    justify-content: center;
    padding-right: 8px;
}

.routes-cell--name {
    flex-grow: 3;
}

.routes-cell--money {
    flex-grow: 2;
}

.routes-cell--button {
    flex-grow: 2;
    align-items: flex-start;
}

.routes-cell--delete {
    flex-grow: 1;
    align-items: flex-end;
}

.routes-header-cell {
    color: rgb(180, 190, 200);
    font-size: var(--font-m);
    white-space: normal;
}

.routes-name-line {
    flex-direction: row;
    align-items: center;
}

.routes-name {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
    margin-right: 8px;
    white-space: normal;
}

.routes-warning,
.route-side-panel__warning {
    color: rgb(255, 120, 120);
    font-size: var(--font-s);
    white-space: normal;
}

.routes-money {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
}

.routes-profit--positive {
    color: rgb(120, 220, 140);
}

.routes-profit--negative {
    color: rgb(255, 120, 120);
}

.routes-button {
    padding: 5px 10px;
    font-size: var(--font-m);
    color: rgb(245, 248, 250);
    background-color: rgba(40, 52, 66, 0.95);
    border-width: 2px;
    border-color: rgb(200, 208, 216);
    border-radius: 8px;
}

.routes-button:hover {
    background-color: rgba(55, 72, 92, 0.98);
}

.routes-button:disabled {
    opacity: 0.5;
}

.routes-create {
    align-self: flex-start;
    margin-top: 8px;
    padding: 8px 16px;
    font-size: var(--font-m);
}

.routes-dialog {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 6, 10, 0.6);
}

.routes-dialog__card {
    width: 460px;
    padding: 18px 20px;
    background-color: rgba(12, 16, 22, 0.98);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(70, 90, 110);
    border-top-width: 4px;
    border-top-color: rgb(96, 180, 120);
}

.routes-dialog__title {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.routes-dialog__field {
    font-size: var(--font-m);
    margin: 0 0 6px 0;
}

.routes-dialog--confirm .routes-dialog__field {
    display: none;
}

.routes-dialog__message {
    color: rgb(255, 160, 160);
    font-size: var(--font-s);
    white-space: normal;
    margin-bottom: 8px;
}

.routes-dialog--confirm .routes-dialog__message {
    color: rgb(210, 218, 226);
}

.routes-dialog__buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.routes-dialog__buttons .routes-button {
    margin-left: 8px;
}

/* Station and vehicle windows of one route (Issue #229): about 20% of the screen, like the contracts panel, so the map
   stays visible and stations can be clicked. */
.route-side-panel {
    width: 20%;
    min-width: 340px;
    max-width: 420px;
}

.route-side-panel__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.route-side-panel__title {
    flex-shrink: 1;
    white-space: normal;
}

.route-side-panel__hint {
    color: rgb(210, 218, 226);
    font-size: var(--font-s);
    white-space: normal;
    margin-top: 6px;
}

.route-stop-card {
    margin-bottom: 8px;
    padding: 8px 10px;
    background-color: rgba(26, 34, 44, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(200, 208, 216);
}

.route-stop-line {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.route-stop-name {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
}

.route-stop-wait {
    color: rgb(210, 218, 226);
    font-size: var(--font-m);
}

.route-stop-arrow {
    min-width: 36px;
}

.route-stop-remove {
    align-self: flex-start;
}

.route-confirm {
    margin-top: 6px;
    padding: 8px 10px;
    background-color: rgba(60, 24, 24, 0.95);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(210, 60, 60);
}

.route-confirm__text {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    white-space: normal;
    margin-bottom: 6px;
}

.route-vehicles-list {
    flex-grow: 0;
    max-height: 40%;
}

.route-vehicle-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding: 6px 10px;
    background-color: rgba(26, 34, 44, 0.95);
    border-radius: 8px;
}

.route-vehicle-name {
    color: rgb(245, 248, 250);
    font-size: var(--font-m);
    flex-shrink: 1;
    white-space: normal;
}

.route-add-section {
    flex-grow: 1;
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgb(70, 90, 110);
}
