    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374741
    m_Localized: Entrez un nom.
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374742
    m_Localized: "32 caract\xE8res au maximum."
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374743
    m_Localized: "Une autre ligne porte d\xE9j\xE0 ce nom."
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374744
    m_Localized: "Supprimer la ligne \xAB\_{0}\_\xBB\_? Ses v\xE9hicules ne seront
      plus affect\xE9s et perdront leur chargement."
