{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transport-tycoon-2/schemas/cargo.schema.json",
  "title": "Cargo definitions",
  "type": "object",
  "required": ["cargo"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cargo": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cargo" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "cargo": {
      "type": "object",
      "required": ["id", "nameKey", "class", "pricePerUnit"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "nameKey": {
          "description": "Localization key; display strings never live in content files (ADR 0011).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "class": { "enum": ["passengers", "cargo"] },
        "pricePerUnit": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
