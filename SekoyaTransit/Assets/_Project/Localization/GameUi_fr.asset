      m_Items: []
  - m_Id: 4077580401676296
    m_Localized: "Les industries de mati\xE8res premi\xE8res gagnent un niveau quand
      au moins {0}\_% de leur production est livr\xE9e pendant {1} mois d'affil\xE9e
      (un mois en dessous remet le compte \xE0 z\xE9ro). Chaque niveau multiplie
      leur production et leur stock par x{2}, jusqu'au niveau {3}."
    m_Metadata:
      m_Items: []
