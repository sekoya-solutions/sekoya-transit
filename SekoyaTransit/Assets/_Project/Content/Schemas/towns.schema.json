{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sekoya-transit/schemas/towns.schema.json",
  "title": "Town population, need tiers, and growth knobs",
  "type": "object",
  "required": [
    "minStartingPopulation",
    "maxStartingPopulation",
    "maxPopulation",
    "demandPerNeedPerMonth",
    "populationPerSatisfiedNeed",
    "passengersPerPopulationUnit",
    "mailPerPopulationUnit",
    "passengerWaitingCapacity",
    "tiers",
    "minTownsPerNeededCargo",
    "names"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "minStartingPopulation": { "type": "integer", "minimum": 1 },
    "maxStartingPopulation": { "type": "integer", "minimum": 1 },
    "maxPopulation": { "type": "integer", "minimum": 1 },
    "demandPerNeedPerMonth": { "type": "integer", "minimum": 1 },
    "populationPerSatisfiedNeed": { "type": "integer", "minimum": 1 },
    "passengersPerPopulationUnit": {
      "description": "Population divisor for passengers generated each production pulse (at least 1 when population > 0).",
      "type": "integer",
      "minimum": 1
    },
    "mailPerPopulationUnit": {
      "description": "Population divisor for mail generated each production pulse (0 when population is below the unit).",
      "type": "integer",
      "minimum": 1
    },
    "passengerWaitingCapacity": {
      "description": "Max passenger-class units waiting at a town (excess generation is wasted).",
      "type": "integer",
      "minimum": 1
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tier" }
    },
    "minTownsPerNeededCargo": {
      "description": "How many towns must plan each level 1-3 freight cargo as a need; generation adds towns until this holds.",
      "type": "integer",
      "minimum": 1
    },
    "names": {
      "description": "Unique town names (real-world capitals) picked per map from the seed; must cover the largest town count.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": ["minPopulation", "level1", "level2", "level3"],
      "additionalProperties": false,
      "properties": {
        "minPopulation": { "type": "integer", "minimum": 0 },
        "level1": { "type": "integer", "minimum": 0 },
        "level2": { "type": "integer", "minimum": 0 },
        "level3": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
