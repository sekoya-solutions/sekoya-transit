<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MapPlayShell.uss" />
    <ui:VisualElement name="shell-root" class="shell-root" picking-mode="Ignore">
        <ui:VisualElement name="hud-panel" class="shell-hud" picking-mode="Ignore">
            <ui:Label name="cash-label" class="shell-cash" text="Cash: …" picking-mode="Ignore" />
            <ui:Label name="hint-label" class="shell-hint" text="…" picking-mode="Ignore" />
            <ui:Button name="vehicles-toggle" class="shell-panel-toggle" text="Vehicles (L)" />
            <ui:Button name="industries-toggle" class="shell-panel-toggle" text="Industries (I)" />
        </ui:VisualElement>
        <ui:VisualElement name="vehicles-panel" class="vehicles-panel vehicles-panel--hidden">
            <ui:Label name="vehicles-title" class="vehicles-title" text="Vehicles" picking-mode="Ignore" />
            <ui:Button name="vehicles-buy" class="vehicles-buy" text="Buy at selected station" />
            <ui:ScrollView name="vehicles-list" class="vehicles-list" />
            <ui:Label name="vehicles-empty" class="vehicles-empty" text="No vehicles yet." picking-mode="Ignore" />
            <ui:VisualElement name="orders-section" class="orders-section">
                <ui:Label name="orders-title" class="orders-title" text="Route" picking-mode="Ignore" />
                <ui:Label name="orders-hint" class="orders-hint" text="…" picking-mode="Ignore" />
                <ui:Label name="orders-selected" class="orders-selected" text="…" picking-mode="Ignore" />
                <ui:ScrollView name="orders-list" class="orders-list" />
                <ui:Label name="orders-empty" class="orders-empty" text="…" picking-mode="Ignore" />
                <ui:Button name="orders-apply" class="orders-apply" text="Apply route" />
                <ui:Label name="orders-status" class="orders-status" text="" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="industries-panel" class="industries-panel industries-panel--hidden">
            <ui:Label name="industries-title" class="industries-title" text="Industries" picking-mode="Ignore" />
            <ui:ScrollView name="industries-list" class="industries-list" />
            <ui:Label name="industries-empty" class="industries-empty" text="No industries on this map." picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="build-toolbar" class="build-toolbar">
            <ui:Button name="tool-select" class="build-tool" text="Select" />
            <ui:Button name="tool-road" class="build-tool" text="Road" />
            <ui:Button name="tool-demolish-road" class="build-tool" text="Demolish road" />
            <ui:Button name="tool-station" class="build-tool" text="Station" />
            <ui:Button name="tool-demolish-station" class="build-tool" text="Demolish station" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
