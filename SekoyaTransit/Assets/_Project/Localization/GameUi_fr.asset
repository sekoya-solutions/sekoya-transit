      m_Items: []
  - m_Id: 2968023449374756
    m_Localized: "Cette gare est d\xE9j\xE0 l'arr\xEAt pr\xE9c\xE9dent."
    m_Metadata:
      m_Items: []
  - m_Id: 2968023449374757
    m_Localized: "Avec moins de 2 gares, les v\xE9hicules de cette ligne ne seront
