{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transport-tycoon-2/schemas/towns.schema.json",
  "title": "Town population and need tiers",
  "type": "object",
  "required": ["minStartingPopulation", "maxStartingPopulation", "maxPopulation", "tiers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "minStartingPopulation": { "type": "integer", "minimum": 1 },
    "maxStartingPopulation": { "type": "integer", "minimum": 1 },
    "maxPopulation": { "type": "integer", "minimum": 1 },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tier" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": ["minPopulation", "level1", "level2", "level3"],
      "additionalProperties": false,
      "properties": {
        "minPopulation": { "type": "integer", "minimum": 0 },
        "level1": { "type": "integer", "minimum": 0 },
        "level2": { "type": "integer", "minimum": 0 },
        "level3": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
